# Copie este arquivo para .env e preencha com seus valores locais:
#   copy .env.example .env
#
# Nunca commite o arquivo .env (ele já está no .gitignore).
# Nunca coloque chaves reais neste exemplo — apenas no .env local.

# Provedor de LLM: openai | ollama
LLM_PROVIDER=ollama

# Chave da API OpenAI — apenas no seu .env local (deixe vazio aqui)
OPENAI_API_KEY=

# Modelo padrão (ajuste conforme sua conta e custo)
OPENAI_MODEL=gpt-4o-mini

# Ollama (modelo local — Etapa 6)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Timeout HTTP em segundos para chamadas ao modelo
LLM_TIMEOUT_SECONDS=120

# Segredo fictício do laboratório (usado em testes de exposição — Etapa 2+)
AEGIS_LAB_FAKE_SECRET=LAB-ONLY-DO-NOT-USE-IN-PRODUCTION
