# Copie este arquivo para .env e preencha com seus valores locais:
#   copy .env.example .env
#
# Nunca commite o arquivo .env (ele já está no .gitignore).

# Provedor de LLM: openai (Ollama será adicionado na Etapa 6)
LLM_PROVIDER=openai

# Chave da API OpenAI — apenas no seu .env local
OPENAI_API_KEY=

# Modelo padrão (ajuste conforme sua conta e custo)
OPENAI_MODEL=gpt-4o-mini

# Timeout HTTP em segundos para chamadas ao modelo
LLM_TIMEOUT_SECONDS=60

# Segredo fictício do laboratório (usado em testes de exposição — Etapa 2+)
AEGIS_LAB_FAKE_SECRET=LAB-ONLY-DO-NOT-USE-IN-PRODUCTION
