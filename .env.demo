# Ambiente controlado para demo / README (copie para .env na gravacao)
#   copy .env.demo .env
#
# Nao coloque chaves reais aqui. A demo usa apps SIMULADAS (sem chamada OpenAI).

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

LLM_TIMEOUT_SECONDS=60

# Segredo FICTICIO apenas para casos de teste no lab
AEGIS_LAB_FAKE_SECRET=LAB-DEMO-CONTROLLED-ENV-ONLY
